# Base URL of the Activity Ranking API (the system under test).
# The SUT is not implemented yet, so requests to it fail — this is the intended RED state.
SUT_BASE_URL=http://localhost:3000

# Open-Meteo dependency URLs. The future SUT calls these for real in production.
# They are the single source of truth: the MSW handlers intercept these same URLs in tests,
# so no test-only URL swap is needed — MSW catches the real-URL call in-process.
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
